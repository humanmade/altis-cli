{
  "name": "altis-cli",
  "type": "module",
  "version": "0.0.0-development",
  "description": "Command-line tool for managing Altis Cloud hosting: stacks, backups, deploys, logs, X-Ray and more.",
  "license": "MIT",
  "homepage": "https://github.com/humanmade/altis-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/humanmade/altis-cli.git"
  },
  "bugs": {
    "url": "https://github.com/humanmade/altis-cli/issues"
  },
  "keywords": [
    "altis",
    "cli",
    "hosting",
    "wordpress"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/smoke.js",
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "prepare": "npm run build",
    "sync-api-types": "node scripts/sync-api-types.js",
    "dev": "node bin/altis-cli.ts",
    "test:native": "node --test test-native/*.test.js",
    "test:live:ssm": "node scripts/live-ssm.js"
  },
  "dependencies": {
    "@automattic/vip-search-replace": "^2.0.0",
    "@humanmade/ssm": "^0.0.3",
    "ansi-escapes": "^2.0.0",
    "application-config": "^1.0.1",
    "base64-stream": "^1.0.0",
    "bytes": "^3.1.2",
    "chalk": "^5.4.1",
    "clipboardy": "^4.0.0",
    "columnify": "^1.6.0",
    "got": "^14.4.7",
    "indent-string": "^3.2.0",
    "inquirer": "^12.8.2",
    "isomorphic-ws": "^4.0.1",
    "latest-version": "^6.0.0",
    "log-update": "^6.1.0",
    "loud-rejection": "^1.6.0",
    "node-cmd": "^5.0.0",
    "node-fetch": "^3.3.2",
    "once": "^1.4.0",
    "open": "^10.2.0",
    "ora": "^8.2.0",
    "progress-stream": "^2.0.0",
    "rimraf": "^6.0.1",
    "split2": "^4.2.0",
    "unused-filename": "^1.0.0",
    "update-notifier": "^7.3.1",
    "ws": "^8.18.3",
    "yargs": "^18.0.0"
  },
  "bin": {
    "altis-cli": "./dist/bin/altis-cli.js"
  },
  "overrides": {
    "@humanmade/ssm": {
      "uuid": "^11.1.1"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/base64-stream": "^1.0.5",
    "@types/bytes": "^3.1.6",
    "@types/columnify": "^1.5.4",
    "@types/loud-rejection": "^1.6.0",
    "@types/node": "^22.20.5",
    "@types/once": "^1.4.5",
    "@types/progress-stream": "^2.0.5",
    "@types/split2": "^4.2.3",
    "@types/update-notifier": "^6.0.8",
    "@types/ws": "^8.18.2",
    "@types/yargs": "^17.0.35",
    "typescript": "~5.9.3"
  }
}
